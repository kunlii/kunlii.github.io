---
layout: default
---
<div class="post">
  <header class="post-header about-hero">
    <div class="about-hero-text">
      <p class="about-eyebrow">Assistant Professor · Shandong University</p>
      <h1 class="about-name">
        {% if site.title == 'blank' %}
          {{ site.first_name }}<br><em>{{ site.last_name }}</em>
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <p class="about-affil">
        School of Computer Science and Technology<br>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </p>
    </div>
    <div class="about-hero-photo">
      {% if page.profile and page.profile.image %}
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        <img src="{{ profile_image_path | relative_url }}" alt="{{ site.first_name }} {{ site.last_name }}">
      {% endif %}
      {% if page.profile and page.profile.more_info %}
        <div class="about-address">{{ page.profile.more_info }}</div>
      {% endif %}
    </div>
  </header>

  <article>
    <div class="about-stats">
      <div class="stat-cell">
        <span class="stat-n">5+</span>
        <span class="stat-l">Years research</span>
      </div>
      <div class="stat-cell">
        <span class="stat-n">IEEE</span>
        <span class="stat-l">TMC · Infocom</span>
      </div>
      <div class="stat-cell">
        <span class="stat-n">2</span>
        <span class="stat-l">Active grants</span>
      </div>
    </div>

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
