{% if site.teachings %}
  <div class="courses">
    {% assign courses_by_title = site.teachings | group_by: 'title' %}
    {% for course_group in courses_by_title %}
      <div class="course-item">
        <h3 class="course-title">
          <a href="{{ course_group.items.first.url | relative_url }}">{{ course_group.name }}</a>
        </h3>
        <div class="course-terms">
          {% assign sorted_items = course_group.items | sort: 'year' | reverse %}
          {% for item in sorted_items %}
            <span class="course-term-tag">
              {% if item.term %}{{ item.term }}{% endif %}
              {% if item.year %}{{ item.year }}{% endif %}
            </span>
          {% endfor %}
        </div>
        {% if course_group.items.first.description %}
          <div class="course-description">
            {{ course_group.items.first.description | markdownify }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>No courses available yet.</p>
{% endif %}
