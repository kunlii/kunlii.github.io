{% if site.teachings %}
  <div class="courses">
    {% for course in site.teachings %}
      <div class="course-item">
        <div class="course-header">
          <h3 class="course-title">
            <a href="{{ course.url | relative_url }}">{{ course.title }}</a>
          </h3>
          {% if course.years.size > 1 %}
            <span class="course-count">Taught {{ course.years.size }}×</span>
          {% endif %}
        </div>
        <div class="course-terms">
          {% if course.years %}
            {% assign sorted_years = course.years | compact | sort | reverse %}
            {% for year in sorted_years %}
              <span class="course-term-tag">
                {% if course.term %}{{ course.term }} {% endif %}{{ year }}
              </span>
            {% endfor %}
          {% endif %}
        </div>
        {% if course.description %}
          <div class="course-description">
            {{ course.description | markdownify }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>No courses available yet.</p>
{% endif %}
